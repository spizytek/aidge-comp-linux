{% if is_int8 %}
{{ out_cdtype[0] }}* {{ out_name[0] }} = ({{ out_cdtype[0] }}*)(mem_0 + {{ name|upper }}_OUTPUT_0_MEM_OFFSET);
export_c_activation_forward_int8(
    {{ in_name[0] }},
    {{ out_name[0] }},
    {{ name|upper }}_INPUT_0_SIZE,
    {{ name|upper }}_ACTIVATION,
    {{ name|upper }}_SCALING_COEF,
    {{ name|upper }}_SHIFT);
{% else %}
{{ out_cdtype[0] }}* {{ out_name[0] }} = ({{ out_cdtype[0] }}*)(mem_0 + {{ name|upper }}_OUTPUT_0_MEM_OFFSET);
export_c_activation_forward(
    {{ in_name[0] }},
    {{ out_name[0] }},
    {{ name|upper }}_INPUT_0_SIZE,
    {{ name|upper }}_ACTIVATION);
{% endif %}
