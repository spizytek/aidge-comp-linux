{#- Fully-connected layer configuration (C) -#}
#ifndef {{ name|upper }}_LAYER_H
#define {{ name|upper }}_LAYER_H

#include "utils/c/typedefs.h"

// Input configuration
#define {{ name|upper }}_IN_BATCH {{ in_batch[0] }}
#define {{ name|upper }}_NB_CHANNELS {{ nb_channels }}
#define {{ name|upper }}_IN_HEIGHT {{ in_height[0] }}
#define {{ name|upper }}_IN_WIDTH {{ in_width[0] }}

// Output configuration
#define {{ name|upper }}_NB_OUTPUTS {{ nb_outputs }}
#define {{ name|upper }}_OUT_HEIGHT {{ out_height[0] }}
#define {{ name|upper }}_OUT_WIDTH {{ out_width[0] }}
#define {{ name|upper }}_OUT_BATCH {{ out_batch[0] }}

// Memory configuration
#define {{ name|upper }}_OUTPUT_0_MEM_OFFSET {{ mem_info_offset[0] | default(0, true) }}
#define {{ name|upper }}_OUTPUT_0_MEM_SIZE {{ mem_info_size[0] | default(0, true) }}
#define {{ name|upper }}_OUTPUT_0_MEM_STRIDE {{ mem_info_stride[0] | default(0, true) }}

#define {{ name|upper }}_WEIGHTS_SIZE {{ weights_size }}
#define {{ name|upper }}_BIASES_SIZE {{ biases_size }}
#define {{ name|upper }}_IS_INT8 {% if is_int8 %}1{% else %}0{% endif %}
#define {{ name|upper }}_SHIFT {{ shift_value | default(0, true) }}
#define {{ name|upper }}_SCALING_COEF {{ scaling_coef | default(1, true) }}
{% if activation == "Rectifier" %}
#define {{ name|upper }}_ACTIVATION EXPORT_C_ACT_RELU
{% else %}
#define {{ name|upper }}_ACTIVATION EXPORT_C_ACT_LINEAR
{% endif %}

#endif /* {{ name|upper }}_LAYER_H */
